[Unit]
Description=Refresh weather display (15 min by day, hourly overnight)

[Timer]
# 05:00-23:45 every 15 minutes (hours 5-23, minutes 0/15/30/45)
OnCalendar=*-*-* 05..23:00/15:00
# 00:00-04:00 once an hour
OnCalendar=*-*-* 00..04:00:00
# Run once after boot if a tick was missed while the Pi was off
Persistent=true
AccuracySec=1min
RandomizedDelaySec=20

[Install]
WantedBy=timers.target
