[Unit]
Description=Fetch the dashboard image (2 min after each Lifebook check)

[Timer]
# Two minutes after the Lifebook publisher, so the PNG is already written.
OnCalendar=*-*-* 05..23:02:00
OnCalendar=*-*-* 05..23:17:00
OnCalendar=*-*-* 05..23:32:00
OnCalendar=*-*-* 05..23:47:00
OnCalendar=*-*-* 00..04:02:00
# Run once after boot if a tick was missed while the Pi was off
Persistent=true
AccuracySec=1min
RandomizedDelaySec=20

[Install]
WantedBy=timers.target
