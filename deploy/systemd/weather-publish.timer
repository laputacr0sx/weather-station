[Unit]
Description=Check the dashboard (15 min by day, hourly overnight)

[Timer]
# 05:00-23:45 every 15 minutes. The service keeps the PNG when the glass
# should wait. The Pi fetches two minutes later and refreshes only on change.
OnCalendar=*-*-* 05..23:00/15:00
# 00:00-04:00 once an hour
OnCalendar=*-*-* 00..04:00:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=20

[Install]
WantedBy=timers.target
